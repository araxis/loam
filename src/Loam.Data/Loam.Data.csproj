<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Loam</RootNamespace>
    <AssemblyName>Loam.Data</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Loam.Data</PackageId>
    <Description>Data controls (DataGrid&lt;T&gt;, SimpleTable, TreeView, Pagination) for the Loam Avalonia control library. Add new LoamData() to Application.Styles alongside LoamTheme.</Description>
    <PackageTags>avalonia;ui;controls;datagrid;treeview;loam;material</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loam\Loam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Loam.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
