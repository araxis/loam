<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Loam</RootNamespace>
    <AssemblyName>Loam</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Loam</PackageId>
    <Version>2.0.2</Version>
    <Description>Pure C# themed controls for Avalonia applications.</Description>
    <PackageTags>avalonia;ui;controls;theme;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>loam-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://araxis.github.io/loam/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/araxis/loam</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Loam.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\loam-icon-512.png" Pack="true" PackagePath="\loam-icon.png" />
  </ItemGroup>

</Project>
