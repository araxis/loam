<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Loam</RootNamespace>
    <AssemblyName>Loam</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging (shared version/license/icon/readme/urls live in Directory.Build.props) -->
    <IsPackable>true</IsPackable>
    <PackageId>Loam</PackageId>
    <Description>Pure C# themed controls for Avalonia applications. The core package; add Loam.Charts, Loam.Pickers, or Loam.Data for those control groups.</Description>
    <PackageTags>avalonia;ui;controls;theme;csharp;material</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Loam.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Loam.Charts</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Loam.Pickers</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Loam.Data</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
