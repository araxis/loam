<Project>

  <!-- Shared build settings for every project in the Loam solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Authors>Loam contributors</Authors>
    <Product>Loam</Product>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Shared package version and metadata for every packable project in the suite.
       The four packages (Loam, Loam.Charts, Loam.Pickers, Loam.Data) version in lockstep.
       CI overrides the published version from the git tag via /p:PackageVersion. -->
  <PropertyGroup>
    <Version>3.2.0</Version>
    <PackageReleaseNotes>Loam 3.2.0: Loam.Charts enrichment — a per-point snapshot (ChartPoint/Labels/ResolvedPoints), donut center text, opt-in signed values (AllowNegative) for diverging bar/line data, and on-chart data labels (ShowDataLabels). Additive; no breaking changes. See https://araxis.github.io/loam/guide/changelog</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>loam-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://araxis.github.io/loam/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/araxis/loam</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
