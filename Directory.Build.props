<Project>

  <!-- Shared build settings for every project in the Loam solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Authors>Loam contributors</Authors>
    <Product>Loam</Product>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Shared package version and metadata for every packable project in the suite.
       The four packages (Loam, Loam.Charts, Loam.Pickers, Loam.Data) version in lockstep.
       CI overrides the published version from the git tag via /p:PackageVersion. -->
  <PropertyGroup>
    <Version>3.20.0</Version>
    <PackageReleaseNotes>Loam 3.20.0: Loam.Data DataGrid row selection — opt-in SelectionMode (None/Single/Multiple), SelectedItem, SelectedItems, and a SelectionChanged event. Click selects; Multiple supports Ctrl-toggle and Shift-range (mouse or keyboard); selection is highlighted and survives sort/filter/page rebuilds by item identity. Ctrl+C copies the selected rows when a selection exists. Defaults to Single (preserves prior behavior). Additive. See https://araxis.github.io/loam/guide/changelog</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>loam-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://araxis.github.io/loam/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/araxis/loam</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
