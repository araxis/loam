<Project>

  <!-- Shared build settings for every project in the Loam solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Authors>Loam contributors</Authors>
    <Product>Loam</Product>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Shared package version and metadata for every packable project in the suite.
       The four packages (Loam, Loam.Charts, Loam.Pickers, Loam.Data) version in lockstep.
       CI overrides the published version from the git tag via /p:PackageVersion. -->
  <PropertyGroup>
    <Version>3.16.0</Version>
    <PackageReleaseNotes>Loam 3.16.0: Loam.Pickers ColorPicker editable hex entry — set Editable to type/paste a hex color (#RRGGBB, or #AARRGGBB with ShowAlpha) into the field; committed on Enter/blur, parsed via Avalonia's color parser (InvalidHexText on failure; empty reverts). The swatch (or Alt+Down) opens the palette and the flyout stays in sync. Public static TryParseColor exposes the rule. Brings editable entry to all four field pickers. Additive, off by default. See https://araxis.github.io/loam/guide/changelog</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>loam-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://araxis.github.io/loam/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/araxis/loam</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
