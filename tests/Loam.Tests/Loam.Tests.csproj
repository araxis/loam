<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Loam.Tests</RootNamespace>
    <!-- xunit v3 test projects build as executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit conventions: underscore test names (CA1707) and instance test methods (CA1822). -->
    <NoWarn>$(NoWarn);CA1707;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Loam.Gallery\Loam.Gallery.csproj" />
    <ProjectReference Include="..\..\src\Loam\Loam.csproj" />
    <ProjectReference Include="..\..\src\Loam.Charts\Loam.Charts.csproj" />
    <ProjectReference Include="..\..\src\Loam.Pickers\Loam.Pickers.csproj" />
    <ProjectReference Include="..\..\src\Loam.Data\Loam.Data.csproj" />
  </ItemGroup>

</Project>
